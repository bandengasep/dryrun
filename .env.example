# Copy to `.env` and fill in (then copy to `web/.env.local` for `next dev`). `.env` is gitignored — never commit real secrets.
# Providers: OpenAI (structured calls) + Agnes AI (interviewer lane) + VideoDB (video answers) + Supabase (save-share debriefs).
OPENAI_API_KEY=
AGNES_API_KEY=
VIDEODB_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional overrides:
# INTERVIEWER_PROVIDER=agnes
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-2.0-flash
# NEXT_PUBLIC_ENABLE_VIDEO=1
# NEXT_PUBLIC_ENABLE_MIC=1   # mic dictation in the session room (unset = hidden)
# OPENAI_SERVICE_TIER=       # "priority" | "flex" — quality-neutral compile-lane serving speed (unset = default tier)
# OPENAI_STRUCTURED_MODEL=   # structured-lane model (gpt-5.6-luna adopted 31 Jul via the mechanical gates; unset = gpt-5-mini)
# PLAN_PROVIDER=             # "agnes" | "openai" — who compiles the plan first; unset/openai = default, agnes falls over to OpenAI on any error
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=